# SAP Knowledge Assistant Configuration

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sap_assistant

# JWT Security
JWT_SECRET=sap-super-secret-jwt-key-2026-production-ready
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Developer / Admin Secret Key for Ingestion
ADMIN_API_KEY=sap-admin-dev-secret-key-999

# LLM Provider Options: 'openai', 'groq', or 'local'
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=

# RAG & Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
TOP_K=10
RERANK_TOP_K=4
SIMILARITY_THRESHOLD=0.60
GROUNDING_THRESHOLD=0.65

# Web Fallback & Tavily Latency Controls
WEB_FALLBACK_ENABLED=True
WEB_SEARCH_API_KEY=
TAVILY_CONNECT_TIMEOUT_SECONDS=3.0
TAVILY_READ_TIMEOUT_SECONDS=8.0
TAVILY_OVERALL_DEADLINE_SECONDS=15.0
TAVILY_MAX_RETRIES=1
TAVILY_MAX_QUERIES=2
TAVILY_MAX_RESULTS=5

# Vision Provider for Screenshot-Guided Troubleshooting
VISION_PROVIDER=groq
VISION_MODEL=llama-3.2-11b-vision-preview
MAX_IMAGE_MB=5
MAX_IMAGES_PER_MESSAGE=3

# Admin Knowledge Base Portal Settings
ADMIN_UPLOAD_MAX_MB=50
ADMIN_UPLOAD_MAX_FILES=25
STORE_ORIGINAL_FILE=true

