# Clyptus.AI - SAP Knowledge Assistant Environment Variables

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/sap_assistant

# JWT Security
JWT_SECRET=your-secure-jwt-secret-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Developer / Admin Secret Key for Ingestion
ADMIN_API_KEY=your-admin-secret-key-here

# LLM Provider Options: 'openai', 'groq', or 'local'
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.8-27b
GROQ_API_KEY=your-groq-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Vision Provider for Screenshot-Guided Troubleshooting
# Options: 'groq' (e.g. llama-3.2-11b-vision-preview), 'openai' (e.g. gpt-4o, gpt-4o-mini), or 'local'
VISION_PROVIDER=groq
VISION_MODEL=llama-3.2-11b-vision-preview
MAX_IMAGE_MB=5
MAX_IMAGES_PER_MESSAGE=3

# RAG & Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
TOP_K=10
RERANK_TOP_K=4
SIMILARITY_THRESHOLD=0.60
GROUNDING_THRESHOLD=0.65

# Web Fallback (Tavily)
WEB_FALLBACK_ENABLED=True
WEB_SEARCH_API_KEY=your-tavily-api-key-here

# Strict KB-first routing and web fallback
INTERNAL_EVIDENCE_THRESHOLD=0.75
KB_CONFIDENCE_THRESHOLD=0.75
TAVILY_MAX_RESULTS=5
TAVILY_TIMEOUT_SECONDS=6
TAVILY_MAX_RETRIES=2

# RAG Document Ingestion Settings
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
BATCH_EMBED_SIZE=64
FORCE_REINGEST=false

# Admin Knowledge Base Portal Settings
ADMIN_UPLOAD_MAX_MB=50
ADMIN_UPLOAD_MAX_FILES=25
STORE_ORIGINAL_FILE=true

